# Backend defaults to deterministic mock curation (no API key required).
CURATION_MODE=mock
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
FRONTEND_ORIGIN=http://localhost:5173
# Frontend dev uses the Vite /api proxy. Set this only for separate hosting.
# VITE_API_URL=https://your-api.example.com

# Native Claude: set LLM_PROVIDER=claude, LLM_BASE_URL=https://api.anthropic.com/v1,
# LLM_MODEL to your supported Claude model ID, and LLM_API_KEY to your Anthropic key.
